<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Email - Mobile Store</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        body {
            background: linear-gradient(135deg, #eef4ff, #f8f9fc);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
        }

        .verification-card {
            background: #fff;
            border: none;
            border-radius: 20px;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.09);
            max-width: 520px;
            width: 100%;
        }

        .verification-icon {
            width: 85px;
            height: 85px;
            border-radius: 50%;
            background: #e8f0ff;
            color: #0d6efd;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 2.5rem;
            margin: 0 auto 24px;
        }

        .email-box {
            background: #f0f6ff;
            border: 1px solid #c9ddff;
            border-radius: 12px;
            padding: 15px;
            overflow-wrap: anywhere;
        }

        .code-input {
            width: 52px;
            height: 60px;
            text-align: center;
            font-size: 1.5rem;
            font-weight: 600;
            border: 1px solid #ced4da;
            border-radius: 10px;
        }

        .code-input:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15);
            outline: none;
        }

        .btn-verify {
            background: #0d6efd;
            color: white;
            border: none;
            border-radius: 10px;
            padding: 13px;
            font-weight: 600;
        }

        .btn-verify:hover {
            background: #0b5ed7;
            color: white;
        }

        .resend-link {
            color: #0d6efd;
            text-decoration: none;
            font-weight: 600;
        }

        .resend-link:hover {
            text-decoration: underline;
        }

        @media (max-width: 420px) {
            .code-input {
                width: 42px;
                height: 52px;
                font-size: 1.2rem;
            }

            .code-inputs {
                gap: 6px !important;
            }
        }
    </style>
</head>

<body class="d-flex align-items-center justify-content-center p-3">

    <div class="card verification-card">
        <div class="card-body p-4 p-md-5 text-center">

            <!-- Icon -->
            <div class="verification-icon">
                <i class="bi bi-envelope-check"></i>
            </div>

            <!-- Heading -->
            <h2 class="fw-bold mb-3">Verify Your Email</h2>

            <p class="text-secondary mb-4">
                We've sent a verification code to your email address.
                Enter the code below to verify your account.
            </p>

            <!-- Email -->
            <div class="email-box text-start mb-4">
                <div class="text-secondary small mb-1">
                    <i class="bi bi-info-circle me-1"></i>
                    Verification code sent to:<div class="fw-bold" style="color: rgb(24, 46, 80); margin-left: 80px; margin-top: 10px; font-size: large;">
                        <%= email %>
                    </div> 
                    
                </div>

            </div>

            <!-- Verification Form -->
            <form action="/auth/verify-code" method="POST" id="verifyForm">

                <input type="hidden" name="email" value="<%= email %>">

                <label class="form-label fw-semibold d-block text-start mb-3">
                    Enter your 6-digit verification code
                </label>

                <div class="code-inputs d-flex justify-content-center gap-2 mb-4">
                    <% for (let i = 0; i < 6; i++) { %>
                        <input
                            type="text"
                            class="form-control code-input"
                            inputmode="numeric"
                            pattern="[0-9]"
                            maxlength="1"
                            aria-label="Verification digit <%= i + 1 %>"
                            required
                        >
                    <% } %>
                </div>

                <!-- Combined code sent as one value -->
                <input type="hidden" name="code" id="verificationCode">

                <p class="text-secondary small mb-4">
                    <i class="bi bi-shield-lock me-1"></i>
                    Please check your inbox and spam folder.
                </p>

                <button type="submit" class="btn btn-verify w-100 mb-4">
                    <i class="bi bi-shield-check me-2"></i>
                    Verify Code
                </button>
            </form>

            <!-- Resend Code -->
            <div class="border-top pt-4">
                <p class="text-secondary mb-2">
                    Didn't receive the code?
                </p>

                <form action="/api/auth/resend-code" method="POST">
                    <input type="hidden" name="email" value="<%= email %>">

                    <button
                        type="submit"
                        class="btn btn-link resend-link p-0">
                        <i class="bi bi-arrow-clockwise me-1"></i>
                        Resend verification code
                    </button>
                </form>
            </div>

            <div class="border-top mt-4 pt-4">
                <a href="/api/auth/login" class="text-decoration-none">
                    <i class="bi bi-arrow-left me-2"></i>
                    Back to Sign In
                </a>
            </div>

        </div>
    </div>

    <script>
        const codeInputs = [...document.querySelectorAll('.code-input')];
        const verifyForm = document.getElementById('verifyForm');

        codeInputs.forEach((input, index) => {
            input.addEventListener('input', () => {
                input.value = input.value.replace(/\D/g, '').slice(-1);

                if (input.value && index < codeInputs.length - 1) {
                    codeInputs[index + 1].focus();
                }
            });

            input.addEventListener('keydown', (event) => {
                if (
                    event.key === 'Backspace' &&
                    !input.value &&
                    index > 0
                ) {
                    codeInputs[index - 1].focus();
                }
            });

            input.addEventListener('paste', (event) => {
                event.preventDefault();

                const pasted = event.clipboardData
                    .getData('text')
                    .replace(/\D/g, '')
                    .slice(0, 6);

                pasted.split('').forEach((digit, i) => {
                    codeInputs[i].value = digit;
                });

                codeInputs[Math.min(pasted.length, 5)].focus();
            });
        });

        verifyForm.addEventListener('submit', (event) => {
            const code = codeInputs.map(input => input.value).join('');

            if (code.length !== 6) {
                event.preventDefault();
                alert('Please enter all 6 digits.');
                return;
            }

            document.getElementById('verificationCode').value = code;
        });
    </script>

</body>
</html>