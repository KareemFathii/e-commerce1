<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password - Mobile Store</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Custom styles for mobile store theme (optional, can be adjusted) -->
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Arial', sans-serif;
        }

        .mobile-store-header {
            background-color: #31455b;
            color: white;
            padding: 1rem 0;
            text-align: center;
        }

        .form-container {
            max-width: 600px;
            margin: 2rem auto;
            padding: 2rem;
            background: white;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
        }

        .btn-primary {
            background-color: #31455b;
            border-color: #7a848f;
        }

        .btn-primary:hover {
            background-color: #31455b;
            border-color: #7a848f;
        }

        .back-link {
            text-align: center;
            margin-top: 1rem;
        }

        .link {
            color: #31455b;
        }
    </style>
</head>

<body>
    <!-- Header -->
    <header class="mobile-store-header">
        <h1>Mobile Store</h1>
        <p class="mb-0">Reset Your Password</p>
    </header>

    <!-- Main Content -->
    <main class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-12 col-md-6 col-lg-5">
                <div class="form-container">
                    <h2 class="text-center mb-4">Reset Password for <%=email%>
                    </h2>
                    <p class="text-center text-muted mb-4">Enter your email address and we'll send you a link to reset
                        your password.</p>

                    <!-- Forgot Password Form -->
                    <form action="/auth/change-password?email=<%=email%>" method="POST">
                        <div class="mb-3">
                            <label for="password" class="form-label">New Password</label>
                            <input type="password" class="form-control" id="password" name="password"
                                placeholder="Enter new password" required>
                            <label for="confirmedPassword" class="form-label mt-3">Confirm Password</label>
                            <input type="password" class="form-control" id="confirmedPassword" name="confirmedPassword"
                                placeholder="Confirm password" required>

                        </div>
                        <button type="submit" class="btn btn-primary w-100">Send Reset Link</button>
                    </form>

                    <!-- Back to Login Link -->
                    <div class="back-link">
                        <a href="" class="text-decoration-none link">Back to Login</a>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer (optional, simple) -->
    <footer class="text-center mt-5 py-3 bg-light">
        <p class="mb-0 text-muted">&copy; 2023 Mobile Store. All rights reserved.</p>
    </footer>

    <!-- Bootstrap 5 JS (for any interactive components, optional) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
</body>

</html>